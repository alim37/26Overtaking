#!/usr/bin/env python3

from __future__ import annotations

import csv
import json
import math
from datetime import datetime
from pathlib import Path

import rclpy
from geometry_msgs.msg import Point
from nav_msgs.msg import Odometry
from rclpy.node import Node
from sensor_msgs.msg import Imu
from std_msgs.msg import Float32, Int32


def stamp_nanoseconds(msg) -> int:
    return int(msg.header.stamp.sec) * 1_000_000_000 + int(
        msg.header.stamp.nanosec
    )


def quaternion_yaw(x: float, y: float, z: float, w: float) -> float:
    return math.atan2(2.0 * (w * z + x * y), 1.0 - 2.0 * (y * y + z * z))


class EpmSysidCollector(Node):
    """Apply reproducible excitation to pure pursuit and log model-ID data."""

    def __init__(self) -> None:
        super().__init__("epm_sysid_collector")

        package_root = Path(__file__).resolve().parents[1]
        self.declare_parameter(
            "output_dir", str(package_root / "output" / "epm_sysid")
        )
        self.declare_parameter("track_name", "ethz")
        self.declare_parameter("direction", "forward")
        self.declare_parameter("num_laps", 8)
        self.declare_parameter("nominal_base_throttle", 0.13)
        self.declare_parameter("command_period_sec", 0.05)
        self.declare_parameter("target_throttle_commands", [0.10, 0.115, 0.13])
        self.declare_parameter("steering_gains", [0.90, 1.00, 1.10])
        self.declare_parameter("steering_excitation_rad", [0.0, 0.008, 0.010])
        self.declare_parameter("steering_excitation_hz", [0.23, 0.31, 0.41])
        self.declare_parameter("throttle_excitation", [0.0, 0.004, 0.006])
        self.declare_parameter("throttle_excitation_hz", [0.13, 0.17, 0.19])
        self.declare_parameter("validation_laps", [3, 6, 8])
        self.declare_parameter("max_abs_steering_rad", 0.54)
        self.declare_parameter("max_throttle", 0.16)

        self.output_dir = Path(
            str(self.get_parameter("output_dir").value)
        ).expanduser()
        self.track_name = str(self.get_parameter("track_name").value)
        self.direction = str(self.get_parameter("direction").value)
        self.num_laps = int(self.get_parameter("num_laps").value)
        self.nominal_base_throttle = float(
            self.get_parameter("nominal_base_throttle").value
        )
        self.command_period_sec = float(
            self.get_parameter("command_period_sec").value
        )
        self.target_throttles = self._array("target_throttle_commands")
        self.steering_gains = self._array("steering_gains")
        self.steering_amplitudes = self._array("steering_excitation_rad")
        self.steering_frequencies = self._array("steering_excitation_hz")
        self.throttle_amplitudes = self._array("throttle_excitation")
        self.throttle_frequencies = self._array("throttle_excitation_hz")
        self.validation_laps = {
            int(value) for value in self.get_parameter("validation_laps").value
        }
        self.max_abs_steering = float(
            self.get_parameter("max_abs_steering_rad").value
        )
        self.max_throttle = float(self.get_parameter("max_throttle").value)

        if self.num_laps <= 0:
            raise ValueError("num_laps must be positive")
        for lap in self.validation_laps:
            if lap < 1 or lap > self.num_laps:
                raise ValueError(
                    f"validation lap {lap} is outside 1..{self.num_laps}"
                )

        self.output_dir.mkdir(parents=True, exist_ok=True)
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        stem = f"epm_sysid_{self.track_name}_{self.direction}_{timestamp}"
        self.output_path = self.output_dir / f"{stem}.csv"
        self.metadata_path = self.output_dir / f"{stem}.json"
        self.csv_file = self.output_path.open("w", newline="", encoding="utf-8")
        self.writer = csv.writer(self.csv_file)
        self.writer.writerow(
            [
                "sensor_timestamp_ns",
                "elapsed_sec",
                "lap",
                "dataset_split",
                "track",
                "direction",
                "profile_target_throttle",
                "profile_steering_gain",
                "profile_steering_excitation_rad",
                "profile_throttle_excitation",
                "ips_x_m",
                "ips_y_m",
                "ips_z_m",
                "odom_x_m",
                "odom_y_m",
                "heading_rad",
                "odom_linear_x_mps",
                "odom_linear_y_mps",
                "odom_linear_z_mps",
                "model_vx_mps",
                "model_vy_mps",
                "imu_angular_x_radps",
                "imu_angular_y_radps",
                "imu_angular_z_radps",
                "model_yaw_rate_radps",
                "imu_accel_x_mps2",
                "imu_accel_y_mps2",
                "imu_accel_z_mps2",
                "nominal_steering_command",
                "nominal_throttle_command",
                "applied_steering_command",
                "applied_throttle_command",
                "steering_feedback",
                "throttle_feedback",
            ]
        )

        self.current_lap_index = 0
        self.start_time_ns: int | None = None
        self.experiment_start_sec: float | None = None
        self.nominal_steering = 0.0
        self.nominal_throttle = 0.0
        self.applied_steering = 0.0
        self.applied_throttle = 0.0
        self.steering_feedback = 0.0
        self.throttle_feedback = 0.0
        self.latest_ips: tuple[float, float, float] | None = None
        self.pending_odom: dict[int, Odometry] = {}
        self.rows_written = 0
        self.finished = False
        self.shutdown_timer = None

        prefix = "/autodrive/f1tenth_1"
        self.steering_pub = self.create_publisher(
            Float32, f"{prefix}/steering_command", 10
        )
        self.throttle_pub = self.create_publisher(
            Float32, f"{prefix}/throttle_command", 10
        )
        self.create_subscription(
            Float32, f"{prefix}/sysid/steering_nominal", self.nominal_steering_cb, 10
        )
        self.create_subscription(
            Float32, f"{prefix}/sysid/throttle_nominal", self.nominal_throttle_cb, 10
        )
        self.create_subscription(
            Float32, f"{prefix}/steering", self.steering_feedback_cb, 10
        )
        self.create_subscription(
            Float32, f"{prefix}/throttle", self.throttle_feedback_cb, 10
        )
        self.create_subscription(Point, f"{prefix}/ips", self.ips_cb, 10)
        self.create_subscription(Odometry, f"{prefix}/odom", self.odom_cb, 30)
        self.create_subscription(Imu, f"{prefix}/imu", self.imu_cb, 30)
        self.create_subscription(
            Int32, f"{prefix}/pure_pursuit/lap_count", self.lap_cb, 10
        )
        self.create_timer(self.command_period_sec, self.publish_command)

        self._write_metadata()
        self.get_logger().info(
            f"EPM system-ID collection ready: laps={self.num_laps}, "
            f"validation_laps={sorted(self.validation_laps)}, output={self.output_path}"
        )

    def _array(self, name: str) -> tuple[float, ...]:
        values = tuple(float(value) for value in self.get_parameter(name).value)
        if not values:
            raise ValueError(f"{name} must contain at least one value")
        return values

    @staticmethod
    def _value(values: tuple[float, ...], index: int) -> float:
        return values[min(max(index, 0), len(values) - 1)]

    def _profile(self) -> dict[str, float]:
        index = self.current_lap_index
        return {
            "target": self._value(self.target_throttles, index),
            "gain": self._value(self.steering_gains, index),
            "steer_amp": self._value(self.steering_amplitudes, index),
            "steer_hz": self._value(self.steering_frequencies, index),
            "throttle_amp": self._value(self.throttle_amplitudes, index),
            "throttle_hz": self._value(self.throttle_frequencies, index),
        }

    def _write_metadata(self) -> None:
        metadata = {
            "track": self.track_name,
            "direction": self.direction,
            "num_laps": self.num_laps,
            "validation_laps_1_based": sorted(self.validation_laps),
            "target_speeds": self.target_speeds,
            "steering_gains": self.steering_gains,
            "steering_excitation_rad": self.steering_amplitudes,
            "steering_excitation_hz": self.steering_frequencies,
            "throttle_excitation": self.throttle_amplitudes,
            "throttle_excitation_hz": self.throttle_frequencies,
            "state_mapping": {
                "model_vx_mps": "odom.twist.twist.linear.z (Unity forward axis)",
                "model_vy_mps": "odom.twist.twist.linear.x (Unity lateral axis)",
                "model_yaw_rate_radps": "imu.angular_velocity.z",
            },
            "synchronization": "odom and imu rows matched by identical bundle timestamp",
        }
        self.metadata_path.write_text(
            json.dumps(metadata, indent=2), encoding="utf-8"
        )

    def nominal_steering_cb(self, msg: Float32) -> None:
        self.nominal_steering = float(msg.data)

    def nominal_throttle_cb(self, msg: Float32) -> None:
        self.nominal_throttle = float(msg.data)

    def steering_feedback_cb(self, msg: Float32) -> None:
        self.steering_feedback = float(msg.data)

    def throttle_feedback_cb(self, msg: Float32) -> None:
        self.throttle_feedback = float(msg.data)

    def ips_cb(self, msg: Point) -> None:
        self.latest_ips = (float(msg.x), float(msg.y), float(msg.z))

    def odom_cb(self, msg: Odometry) -> None:
        stamp = stamp_nanoseconds(msg)
        self.pending_odom[stamp] = msg
        if len(self.pending_odom) > 100:
            del self.pending_odom[min(self.pending_odom)]

    def imu_cb(self, msg: Imu) -> None:
        stamp = stamp_nanoseconds(msg)
        odom = self.pending_odom.pop(stamp, None)
        if odom is not None:
            self.log_synchronized_sample(stamp, odom, msg)

    def lap_cb(self, msg: Int32) -> None:
        completed_laps = int(msg.data)
        if completed_laps >= self.num_laps:
            self.finish()
            return
        self.current_lap_index = completed_laps
        profile = self._profile()
        self.get_logger().info(
            f"Starting lap {self.current_lap_index + 1}/{self.num_laps}: "
            f"target={profile['target']:.3f}, gain={profile['gain']:.2f}, "
            f"steer_amp={profile['steer_amp']:.4f}, "
            f"throttle_amp={profile['throttle_amp']:.4f}"
        )

    def publish_command(self) -> None:
        if self.finished:
            self.steering_pub.publish(Float32(data=0.0))
            self.throttle_pub.publish(Float32(data=0.0))
            return

        now = self.get_clock().now().nanoseconds * 1e-9
        if self.experiment_start_sec is None:
            self.experiment_start_sec = now
        elapsed = now - self.experiment_start_sec
        profile = self._profile()
        phase = 0.83 * self.current_lap_index

        steering_excitation = profile["steer_amp"] * (
            math.sin(2.0 * math.pi * profile["steer_hz"] * elapsed + phase)
            + 0.35
            * math.sin(
                2.0 * math.pi * 1.73 * profile["steer_hz"] * elapsed
                + 0.5 * phase
            )
        )
        self.applied_steering = max(
            -self.max_abs_steering,
            min(
                self.max_abs_steering,
                profile["gain"] * self.nominal_steering + steering_excitation,
            ),
        )

        if abs(self.nominal_base_throttle) > 1e-9:
            corner_scale = max(
                0.0, min(1.0, self.nominal_throttle / self.nominal_base_throttle)
            )
        else:
            corner_scale = 0.0
        throttle_excitation = profile["throttle_amp"] * math.sin(
            2.0 * math.pi * profile["throttle_hz"] * elapsed + 1.3 * phase
        )
        self.applied_throttle = max(
            0.0,
            min(
                self.max_throttle,
                profile["target"] * corner_scale + throttle_excitation,
            ),
        )

        self.steering_pub.publish(Float32(data=float(self.applied_steering)))
        self.throttle_pub.publish(Float32(data=float(self.applied_throttle)))

    def log_synchronized_sample(
        self, stamp: int, odom: Odometry, imu: Imu
    ) -> None:
        if self.finished or self.latest_ips is None:
            return
        if self.start_time_ns is None:
            self.start_time_ns = stamp

        pose = odom.pose.pose
        twist = odom.twist.twist
        angular = imu.angular_velocity
        accel = imu.linear_acceleration
        heading = quaternion_yaw(
            float(pose.orientation.x),
            float(pose.orientation.y),
            float(pose.orientation.z),
            float(pose.orientation.w),
        )
        profile = self._profile()
        lap = self.current_lap_index + 1
        split = "validation" if lap in self.validation_laps else "train"

        self.writer.writerow(
            [
                stamp,
                f"{(stamp - self.start_time_ns) * 1e-9:.9f}",
                lap,
                split,
                self.track_name,
                self.direction,
                f"{profile['target']:.9f}",
                f"{profile['gain']:.9f}",
                f"{profile['steer_amp']:.9f}",
                f"{profile['throttle_amp']:.9f}",
                f"{self.latest_ips[0]:.9f}",
                f"{self.latest_ips[1]:.9f}",
                f"{self.latest_ips[2]:.9f}",
                f"{pose.position.x:.9f}",
                f"{pose.position.y:.9f}",
                f"{heading:.9f}",
                f"{twist.linear.x:.9f}",
                f"{twist.linear.y:.9f}",
                f"{twist.linear.z:.9f}",
                f"{twist.linear.z:.9f}",
                f"{twist.linear.x:.9f}",
                f"{angular.x:.9f}",
                f"{angular.y:.9f}",
                f"{angular.z:.9f}",
                f"{angular.z:.9f}",
                f"{accel.x:.9f}",
                f"{accel.y:.9f}",
                f"{accel.z:.9f}",
                f"{self.nominal_steering:.9f}",
                f"{self.nominal_throttle:.9f}",
                f"{self.applied_steering:.9f}",
                f"{self.applied_throttle:.9f}",
                f"{self.steering_feedback:.9f}",
                f"{self.throttle_feedback:.9f}",
            ]
        )
        self.rows_written += 1
        if self.rows_written % 100 == 0:
            self.csv_file.flush()

    def finish(self) -> None:
        if self.finished:
            return
        self.finished = True
        self.steering_pub.publish(Float32(data=0.0))
        self.throttle_pub.publish(Float32(data=0.0))
        self.close_file()
        self.get_logger().info(
            f"Completed {self.num_laps} laps; saved {self.rows_written} "
            f"synchronized samples to {self.output_path}"
        )
        self.shutdown_timer = self.create_timer(0.5, self.request_shutdown)

    def close_file(self) -> None:
        if self.csv_file.closed:
            return
        self.csv_file.flush()
        self.csv_file.close()

    def request_shutdown(self) -> None:
        if self.shutdown_timer is not None:
            self.shutdown_timer.cancel()
        if rclpy.ok():
            rclpy.shutdown()

    def destroy_node(self) -> bool:
        self.close_file()
        return super().destroy_node()


def main(args=None) -> None:
    rclpy.init(args=args)
    node = EpmSysidCollector()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
